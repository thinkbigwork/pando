# Config de Firebase para la app web (proyecto pando-dev).
# Copiá este archivo a `web/.env.local` y completá con los valores de la consola
# de Firebase (Configuración del proyecto → Tus apps → SDK de configuración).
# Estas claves son públicas por diseño (config del cliente Firebase); las claves
# realmente secretas van en Secret Manager, nunca acá.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pando-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pando-dev
VITE_FIREBASE_STORAGE_BUCKET=pando-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poné 1 para desarrollar contra los emuladores locales.
VITE_USE_EMULATORS=1
