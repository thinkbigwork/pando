# Parámetros no secretos de las Cloud Functions.
# Copiá a `functions/.env.pando-dev` (o `functions/.env.local` para emulador).
# Los SECRETOS (ANTHROPIC_API_KEY, tokens de Slack/WhatsApp/Jira) NO van acá:
# se cargan con `firebase functions:secrets:set NOMBRE`.

# Email que recibe el rol CEO en el primer arranque (function bootstrapAdmin).
BOOTSTRAP_ADMIN_EMAIL=desk@wizor.io
